    {
      "type": "java",
      "name": "Auth Service - local",
      "request": "launch",
      "mainClass": "com.atlascommerce.auth.AuthServiceApplication",
      "projectName": "auth-service",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
