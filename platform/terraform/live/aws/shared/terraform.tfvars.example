aws_region = "eu-central-1"

project     = "atlas-commerce"
environment = "shared"

repository_prefix = "atlas-commerce"

repository_names = [
  "auth-service",
  "catalog-service",
  "cart-service",
  "pricing-service",
  "coupon-service",
  "inventory-service",
  "payment-service",
  "order-service",
  "shipping-service",
  "notification-service",
  "audit-service",
  "api-gateway"
]

scan_on_push                   = true
image_tag_mutability           = "IMMUTABLE"
max_tagged_images              = 20
untagged_image_expiration_days = 7

additional_tags = {
  Purpose = "shared-container-registry"
}
